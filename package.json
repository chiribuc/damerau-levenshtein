{
  "name": "@crob/damerau-levenshtein",
  "version": "2.0.0",
  "description": "Fast, dependency-free Damerau-Levenshtein edit distance with configurable operation costs.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.cjs",
  "jsdelivr": "./dist/index.umd.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/emit-cjs-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:package": "publint && attw --pack .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiribuc/damerau-levenshtein.git"
  },
  "bugs": {
    "url": "https://github.com/chiribuc/damerau-levenshtein/issues"
  },
  "homepage": "https://github.com/chiribuc/damerau-levenshtein#readme",
  "keywords": [
    "damerau-levenshtein",
    "levenshtein",
    "edit-distance",
    "string-distance",
    "fuzzy-search",
    "spell-check",
    "typescript"
  ],
  "author": "Robert-Cristian Chiribuc",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
